{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://campaign-optimizer.local/schemas/plan_decision_event.schema.json",
  "title": "Plan Accept or Reject Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "decision_id", "plan_id", "plan_source_version",
    "plan_hash", "decision", "actor_id", "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "decision_id": { "type": "string", "minLength": 1 },
    "plan_id": { "type": "string", "minLength": 1 },
    "plan_source_version": { "type": "string", "minLength": 1 },
    "plan_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decision": { "enum": ["ACCEPT", "REJECT"] },
    "actor_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
