{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://campaign-optimizer.local/schemas/ontology_review.schema.json",
  "title": "Ontology Review",
  "description": "本体对完整最终方案的结构化审核快照，不包含替代方案。",
  "type": "object",
  "required": [
    "schema_version",
    "review_id",
    "plan_id",
    "source",
    "ontology_version",
    "release_identity",
    "confidence_state_version",
    "is_synthetic",
    "overall_verdict",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "review_id": {
      "type": "string",
      "pattern": "^review_[A-Za-z0-9_-]+$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^plan_[A-Za-z0-9_-]+$"
    },
    "source": {
      "type": "string",
      "enum": ["DEMO_ONTOLOGY_STUB", "ONTOLOGY_ENGINE"]
    },
    "ontology_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "release_identity": {
      "type": "object",
      "required": [
        "ontology_version",
        "rule_version",
        "engine_version",
        "schema_version",
        "source_commit",
        "package_checksum"
      ],
      "additionalProperties": false,
      "properties": {
        "ontology_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "rule_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "engine_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "schema_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "package_checksum": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "confidence_state_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "is_synthetic": { "type": "boolean" },
    "overall_verdict": { "$ref": "#/definitions/verdict" },
    "items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/review_item" }
    }
  },
  "definitions": {
    "verdict": {
      "type": "string",
      "enum": [
        "SUPPORT",
        "CONFLICT",
        "NOT_APPLICABLE",
        "UNVERIFIED",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "review_item": {
      "type": "object",
      "required": [
        "review_item_id",
        "plan_item_id",
        "verdict",
        "rule_id",
        "rule_version",
        "base_confidence",
        "runtime_confidence",
        "matched_fact_ids",
        "missing_evidence",
        "missing_rule_parameters",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "review_item_id": {
          "type": "string",
          "pattern": "^review_item_[A-Za-z0-9_-]+$"
        },
        "plan_item_id": {
          "type": "string",
          "pattern": "^plan_item_[A-Za-z0-9_-]+$"
        },
        "verdict": { "$ref": "#/definitions/verdict" },
        "rule_id": {
          "type": ["string", "null"],
          "pattern": "^R[0-9]+$"
        },
        "rule_version": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 64
        },
        "base_confidence": { "$ref": "#/definitions/confidence" },
        "runtime_confidence": { "$ref": "#/definitions/confidence" },
        "matched_fact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^review_fact_[A-Za-z0-9_-]+$"
          }
        },
        "missing_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "missing_rule_parameters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "verdict": { "const": "UNVERIFIED" } },
            "required": ["verdict"]
          },
          "then": {
            "properties": {
              "rule_id": { "type": "null" },
              "rule_version": { "type": "null" },
              "base_confidence": { "type": "null" },
              "runtime_confidence": { "type": "null" },
              "matched_fact_ids": { "maxItems": 0 },
              "missing_evidence": { "maxItems": 0 },
              "missing_rule_parameters": { "maxItems": 0 }
            }
          },
          "else": {
            "properties": {
              "rule_id": { "type": "string", "pattern": "^R[0-9]+$" },
              "rule_version": { "type": "string", "minLength": 1, "maxLength": 64 }
            }
          }
        },
        {
          "if": {
            "properties": { "verdict": { "enum": ["SUPPORT", "CONFLICT", "NOT_APPLICABLE"] } },
            "required": ["verdict"]
          },
          "then": {
            "properties": {
              "base_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "runtime_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "matched_fact_ids": { "minItems": 1 },
              "missing_evidence": { "maxItems": 0 },
              "missing_rule_parameters": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "verdict": { "const": "INSUFFICIENT_EVIDENCE" } },
            "required": ["verdict"]
          },
          "then": {
            "anyOf": [
              { "properties": { "missing_evidence": { "minItems": 1 } } },
              { "properties": { "missing_rule_parameters": { "minItems": 1 } } }
            ]
          }
        }
      ]
    }
  }
}
