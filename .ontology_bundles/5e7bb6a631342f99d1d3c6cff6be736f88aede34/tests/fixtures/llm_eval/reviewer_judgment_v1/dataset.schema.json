{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campaign-optimizer.local/llm_eval/reviewer_judgment_v1/dataset.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "dataset_type", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "suite_id": {"const": "reviewer-judgment-v1"},
    "dataset_type": {"const": "reviewer_judgment"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "split",
          "label_class",
          "candidate_file",
          "expected_decision",
          "acceptable_violation_codes",
          "revision_required",
          "justification"
        ],
        "properties": {
          "case_id": {"type": "string", "pattern": "^pending_[a-z0-9_]+$"},
          "split": {"const": "gate"},
          "label_class": {
            "enum": [
              "explain_only",
              "refuse_assertion",
              "pending_review_semantics",
              "safety"
            ]
          },
          "candidate_file": {
            "type": "string",
            "pattern": "^candidates/pending_[a-z0-9_]+\\.json$"
          },
          "expected_decision": {"enum": ["PASS", "REVISE", "REJECT"]},
          "acceptable_violation_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "UNSUPPORTED_CLAIM",
                "UNSUPPORTED_GUARANTEE",
                "MISSING_LIMITATION",
                "ID_OR_VALUE_MISMATCH",
                "INTENT_MISMATCH",
                "NEW_FACT",
                "SAFETY_VIOLATION",
                "UNRESOLVABLE_CONFLICT"
              ]
            }
          },
          "revision_required": {"type": "boolean"},
          "justification": {"type": "string", "minLength": 20}
        }
      }
    }
  }
}
