# Copy to .env and replace every change-me value before shared deployment.
APP_ENV=demo
# Local default. On ECS, replace this with a URL stored in a server-only .env
# or Alibaba Cloud secret configuration. URL-encode special characters in the
# username/password. PolarDB PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://review_api:ENCODED_PASSWORD@pc-example.pg.polardb.rds.aliyuncs.com:5432/ontology_review?connect_timeout=5
DATABASE_URL=sqlite:////data/review.db
ONTOLOGY_PATH=/ontology
EXPECTED_ONTOLOGY_CHECKSUM=a2eaaf287417469a592ecb48d3a31759f930761bc97269e9c61618b7f65ca858
FINAL_PLAN_SCHEMA_PATH=/contracts/final_plan.schema.json
ONTOLOGY_REVIEW_SCHEMA_PATH=/contracts/ontology_review.schema.json
DOCS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
# key:principal_id:tenant:role, comma separated. Never commit real keys.
API_KEY_PRINCIPALS=change-me-agent:demo-agent:demo:SERVICE,change-me-reviewer:demo-reviewer:demo:REVIEWER
# Server-owned client used because the shared final_plan contract has no client_id.
PLAN_REVIEW_CLIENT_ID=demo_client_001
