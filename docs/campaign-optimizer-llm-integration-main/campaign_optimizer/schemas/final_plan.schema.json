{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://campaign-optimizer.local/schemas/final_plan.schema.json",
  "title": "Final Plan",
  "description": "小模型链路产出的唯一最终方案。LLM和本体不得修改其中的动作或数值。",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "source",
    "source_version",
    "period",
    "items",
    "decision_evidence",
    "review_evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "plan_id": {
      "type": "string",
      "pattern": "^plan_[A-Za-z0-9_-]+$"
    },
    "source": {
      "type": "string",
      "enum": ["DEMO_OPTIMIZER_STUB", "SMALL_MODEL_CHAIN"]
    },
    "source_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "period": { "$ref": "#/definitions/period" },
    "items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/plan_item" }
    },
    "decision_evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/decision_fact" }
    },
    "review_evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/review_fact" }
    }
  },
  "definitions": {
    "period": {
      "type": "object",
      "required": ["type", "start_date", "end_date"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "next_14_days" },
        "start_date": { "type": "string", "format": "date" },
        "end_date": { "type": "string", "format": "date" }
      }
    },
    "plan_item": {
      "type": "object",
      "required": [
        "plan_item_id",
        "entity_type",
        "entity_id",
        "action",
        "delta_pct",
        "current_budget",
        "recommended_budget",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "plan_item_id": {
          "type": "string",
          "pattern": "^plan_item_[A-Za-z0-9_-]+$"
        },
        "entity_type": {
          "type": "string",
          "enum": ["channel", "touchpoint", "campaign", "account"]
        },
        "entity_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "action": {
          "type": "string",
          "enum": [
            "increase_budget",
            "decrease_budget",
            "keep_budget"
          ]
        },
        "delta_pct": {
          "type": "number",
          "minimum": -100,
          "maximum": 1000
        },
        "current_budget": {
          "type": "number",
          "minimum": 0
        },
        "recommended_budget": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "fact_value": {
      "oneOf": [
        { "type": "number" },
        { "type": "string", "maxLength": 500 },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "fact": {
      "type": "object",
      "required": [
        "fact_id",
        "plan_item_id",
        "entity_type",
        "entity_id",
        "name",
        "value",
        "unit",
        "period",
        "source",
        "scope"
      ],
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "type": "string",
          "pattern": "^(decision|review)_fact_[A-Za-z0-9_-]+$"
        },
        "plan_item_id": {
          "type": "string",
          "pattern": "^plan_item_[A-Za-z0-9_-]+$"
        },
        "entity_type": {
          "type": "string",
          "enum": ["channel", "touchpoint", "campaign", "account"]
        },
        "entity_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "value": { "$ref": "#/definitions/fact_value" },
        "baseline_value": { "type": ["number", "null"] },
        "baseline_source": { "type": ["string", "null"], "minLength": 1, "maxLength": 100 },
        "baseline_period": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 },
        "unit": {
          "type": "string",
          "enum": [
            "ratio",
            "percentage",
            "currency",
            "count",
            "boolean",
            "text"
          ]
        },
        "period": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "scope": {
          "type": "string",
          "enum": ["public_output", "ontology_review"]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["baseline_value"],
            "properties": { "baseline_value": { "type": "number" } }
          },
          "then": {
            "required": ["baseline_source", "baseline_period"],
            "properties": {
              "baseline_source": { "type": "string" },
              "baseline_period": { "type": "string" }
            }
          }
        }
      ]
    },
    "decision_fact": {
      "allOf": [
        { "$ref": "#/definitions/fact" },
        {
          "properties": {
            "fact_id": { "type": "string", "pattern": "^decision_fact_[A-Za-z0-9_-]+$" },
            "scope": { "const": "public_output" }
          }
        }
      ]
    },
    "review_fact": {
      "allOf": [
        { "$ref": "#/definitions/fact" },
        {
          "properties": {
            "fact_id": { "type": "string", "pattern": "^review_fact_[A-Za-z0-9_-]+$" },
            "scope": { "const": "ontology_review" }
          }
        }
      ]
    }
  }
}
