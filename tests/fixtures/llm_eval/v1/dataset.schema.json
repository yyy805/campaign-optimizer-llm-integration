{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/llm-eval-dataset-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "dataset_type",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "suite_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
    },
    "dataset_type": {
      "enum": [
        "routing_safety",
        "generation",
        "prompt_attacks"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "fixtures": {
      "$ref": "#/$defs/fixtures"
    },
    "frozen_inputs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/frozen_input"
      }
    },
    "quality_rubrics": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/quality_rubric"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "common_executor_configs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/common_executor_config"
      }
    },
    "arm_configs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/arm_config"
      }
    },
    "candidate_fixtures": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/candidate_fixture"
      }
    },
    "measurement_contract": {
      "$ref": "#/$defs/measurement_contract"
    }
  },
  "$defs": {
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan",
        "review",
        "valid_output"
      ],
      "properties": {
        "plan": {
          "type": "string"
        },
        "review": {
          "type": "string"
        },
        "valid_output": {
          "type": "string"
        }
      }
    },
    "route_expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "confidence"
      ],
      "properties": {
        "source": {
          "enum": [
            "deterministic_explicit",
            "hard_policy",
            "classifier_unavailable",
            "compound_or_extra",
            "backend_fixed",
            "classifier",
            "classifier_low_confidence",
            "classifier_failed",
            "classifier_invalid"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "frozen_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "question",
        "expected_intent",
        "split",
        "paraphrase_family_id",
        "provenance",
        "annotator_version"
      ],
      "properties": {
        "mode": {
          "const": "chat"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "expected_intent": {
          "enum": [
            "EXPLAIN_PLAN",
            "EXPLAIN_REVIEW",
            "EXPLAIN_RULE"
          ]
        },
        "split": {
          "enum": [
            "dev",
            "test"
          ]
        },
        "paraphrase_family_id": {
          "type": "string",
          "pattern": "^family_[a-z0-9_]{3,79}$"
        },
        "provenance": {
          "const": "synthetic_authored_v1"
        },
        "annotator_version": {
          "const": "human_policy_v1.0"
        }
      }
    },
    "quality_rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimensions",
        "pass_threshold",
        "hard_gates"
      ],
      "properties": {
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority_fidelity",
            "completeness",
            "clarity",
            "safety"
          ],
          "properties": {
            "authority_fidelity": {
              "const": 0.4
            },
            "completeness": {
              "const": 0.25
            },
            "clarity": {
              "const": 0.15
            },
            "safety": {
              "const": 0.2
            }
          }
        },
        "pass_threshold": {
          "const": 0.85
        },
        "hard_gates": {
          "type": "array",
          "const": [
            "schema_valid",
            "authority_ids_only",
            "numeric_values_exact",
            "no_new_facts"
          ]
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "category",
        "scenario",
        "mode",
        "expected_status",
        "expected_provider_calls",
        "tags",
        "split",
        "paraphrase_family_id",
        "provenance",
        "annotator_version"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{2,79}$"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "scenario": {
          "enum": [
            "routing_eval",
            "generation_eval",
            "prompt_attack_eval"
          ]
        },
        "mode": {
          "enum": [
            "chat",
            "initial_render"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "expected_intent": {
          "enum": [
            "EXPLAIN_PLAN",
            "EXPLAIN_REVIEW",
            "EXPLAIN_RULE",
            "FORBIDDEN_MODEL_INTERNAL",
            "UNSUPPORTED_WHAT_IF",
            "OUT_OF_SCOPE"
          ]
        },
        "expected_status": {
          "enum": [
            "OK",
            "REFUSED",
            "FALLBACK"
          ]
        },
        "expected_provider_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "route_expectation": {
          "$ref": "#/$defs/route_expectation"
        },
        "provider_access": {
          "enum": [
            "ALLOW",
            "DENY"
          ]
        },
        "expected_reason": {
          "enum": [
            "FORBIDDEN_MODEL_INTERNAL",
            "UNSUPPORTED_WHAT_IF",
            "OUT_OF_SCOPE"
          ]
        },
        "canary": {
          "type": "string",
          "pattern": "^SYNTHETIC_CANARY_[A-Z0-9_]+$"
        },
        "canary_assertion": {
          "const": "ABSENT_FROM_OUTPUT_AND_METADATA"
        },
        "pair_id": {
          "type": "string",
          "pattern": "^pair_[0-9]{2}$"
        },
        "comparison_arm": {
          "enum": [
            "baseline",
            "reviewer_candidate"
          ]
        },
        "frozen_input_id": {
          "type": "string",
          "pattern": "^input_[0-9]{2}$"
        },
        "quality_rubric_id": {
          "const": "rubric_01"
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,39}$"
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "schema_valid",
              "status_ok",
              "intent_exact",
              "authority_ids_only",
              "numeric_values_exact",
              "limitations_preserved",
              "no_new_facts",
              "retry_count_zero",
              "fallback_false",
              "answer_non_empty",
              "metadata_safe"
            ]
          }
        },
        "split": {
          "enum": [
            "dev",
            "test"
          ]
        },
        "paraphrase_family_id": {
          "type": "string",
          "pattern": "^family_[a-z0-9_]{3,79}$"
        },
        "provenance": {
          "const": "synthetic_authored_v1"
        },
        "annotator_version": {
          "const": "human_policy_v1.0"
        },
        "classifier_fixture": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fixture_type",
                "intent",
                "confidence"
              ],
              "properties": {
                "fixture_type": {
                  "const": "result"
                },
                "intent": {
                  "enum": [
                    "EXPLAIN_PLAN",
                    "EXPLAIN_REVIEW",
                    "EXPLAIN_RULE"
                  ]
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fixture_type"
              ],
              "properties": {
                "fixture_type": {
                  "const": "error"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fixture_type",
                "intent",
                "confidence"
              ],
              "properties": {
                "fixture_type": {
                  "const": "invalid"
                },
                "intent": {
                  "enum": [
                    "EXPLAIN_PLAN",
                    "EXPLAIN_REVIEW",
                    "EXPLAIN_RULE"
                  ]
                },
                "confidence": {
                  "const": "not-a-number"
                }
              }
            }
          ]
        },
        "canary_placement": {
          "const": "CONTROLLED_REQUEST_SUFFIX_NO_PROVIDER"
        },
        "common_executor_config_id": {
          "const": "executor_01"
        },
        "arm_config_id": {
          "enum": [
            "baseline_01",
            "reviewer_01"
          ]
        },
        "candidate_id": {
          "enum": [
            "candidate_clean_plan",
            "candidate_clean_review",
            "candidate_clean_rule",
            "candidate_semantic_guarantee_review",
            "candidate_numeric_error_review"
          ]
        },
        "observed_cost_cny": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "observed_latency_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "arm_expectation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider_calls",
            "revision_rounds",
            "status",
            "reviewer_action"
          ],
          "properties": {
            "provider_calls": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "revision_rounds": {
              "enum": [
                0,
                1
              ]
            },
            "status": {
              "enum": [
                "OK",
                "FALLBACK"
              ]
            },
            "reviewer_action": {
              "enum": [
                "NOT_APPLICABLE",
                "PASS",
                "REVISE",
                "REJECT",
                "FALLBACK"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scenario": {
                "enum": [
                  "routing_eval",
                  "prompt_attack_eval"
                ]
              }
            }
          },
          "then": {
            "required": [
              "question",
              "expected_intent",
              "route_expectation",
              "provider_access"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "expected_status": {
                "const": "REFUSED"
              }
            }
          },
          "then": {
            "required": [
              "expected_reason",
              "canary",
              "canary_assertion",
              "canary_placement"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "scenario": {
                "const": "generation_eval"
              }
            }
          },
          "then": {
            "required": [
              "expected_intent",
              "pair_id",
              "comparison_arm",
              "frozen_input_id",
              "common_executor_config_id",
              "arm_config_id",
              "candidate_id",
              "quality_rubric_id",
              "observed_cost_cny",
              "observed_latency_ms",
              "checks",
              "arm_expectation"
            ]
          }
        }
      ]
    },
    "common_executor_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_alias",
        "temperature",
        "response_format",
        "runs",
        "seed",
        "max_output_tokens",
        "timeout_seconds"
      ],
      "properties": {
        "model_alias": {
          "const": "candidate-under-test"
        },
        "temperature": {
          "const": 0
        },
        "response_format": {
          "const": "json_object"
        },
        "runs": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "arm_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_enabled",
        "max_revision_rounds"
      ],
      "properties": {
        "reviewer_enabled": {
          "type": "boolean"
        },
        "max_revision_rounds": {
          "enum": [
            0,
            1
          ]
        },
        "reviewer_model_alias": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "candidate_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_type",
        "file",
        "intent",
        "candidate_role",
        "expected_guard",
        "expected_reviewer_action"
      ],
      "properties": {
        "candidate_type": {
          "enum": [
            "clean",
            "semantic_guarantee_error",
            "subtle_numeric_error"
          ]
        },
        "file": {
          "type": "string",
          "pattern": "^candidates/[a-z0-9-]+\\.json$"
        },
        "intent": {
          "enum": [
            "EXPLAIN_PLAN",
            "EXPLAIN_REVIEW",
            "EXPLAIN_RULE"
          ]
        },
        "candidate_role": {
          "enum": [
            "paired",
            "hard_gate_only"
          ]
        },
        "expected_guard": {
          "enum": [
            "PASS",
            "REJECT"
          ]
        },
        "expected_reviewer_action": {
          "enum": [
            "PASS",
            "REVISE",
            "NOT_APPLICABLE"
          ]
        }
      }
    },
    "measurement_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cost_currency",
        "latency_unit",
        "unexecuted_value"
      ],
      "properties": {
        "cost_currency": {
          "const": "CNY"
        },
        "latency_unit": {
          "const": "ms"
        },
        "unexecuted_value": {
          "type": "null"
        }
      }
    }
  }
}
